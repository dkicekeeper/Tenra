			<string>%d операция</string>
			<key>few</key>
			<string>%d операции</string>
			<key>many</key>
			<string>%d операций</string>
			<key>other</key>
			<string>%d операций</string>
		</dict>
	</dict>
	<key>voiceConfirmation.confirmCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@operations@</string>
		<key>operations</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
