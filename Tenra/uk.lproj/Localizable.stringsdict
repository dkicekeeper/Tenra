<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>history.count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@operations@</string>
		<key>operations</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d операція</string>
			<key>few</key>
			<string>%d операції</string>
			<key>many</key>
			<string>%d операцій</string>
			<key>other</key>
			<string>%d операцій</string>
		</dict>
	</dict>
	<key>voiceConfirmation.confirmCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@operations@</string>
		<key>operations</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Підтвердити %d операцію</string>
			<key>few</key>
			<string>Підтвердити %d операції</string>
			<key>many</key>
			<string>Підтвердити %d операцій</string>
			<key>other</key>
			<string>Підтвердити %d операцій</string>
		</dict>
	</dict>
	<key>intent.checkSpending.transactionCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@transactions@</string>
		<key>transactions</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d операція</string>
			<key>few</key>
			<string>%d операції</string>
			<key>many</key>
			<string>%d операцій</string>
			<key>other</key>
			<string>%d операції</string>
		</dict>
	</dict>
</dict>
</plist>
